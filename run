# 0. setup
mkdir scijepa && cd scijepa      # create all files above here
pip install -r requirements.txt

# 1. SMOKE TEST FIRST (≈2 min) — catches any error before you scale up
python experiments.py --study all --smoke

# 2. If smoke passes, scale up. Edit experiments.py bottom OR set tier in a wrapper:
#    For a real pretraining run, in config.py call set_tier("P1") or edit defaults.
python -c "from config import set_tier; set_tier('P1')"   # (then run studies)

# 3. Run the real studies (one at a time recommended; each trains many models)
python experiments.py --study lambda   --seeds 3
python experiments.py --study ablation --seeds 3
python experiments.py --study dropout  --seeds 3
